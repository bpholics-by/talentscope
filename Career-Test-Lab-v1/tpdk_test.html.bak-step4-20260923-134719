}

async function calculateScores() {
    // ====================================================
    // FASE 3B â€” HITUNG SKOR DI SERVER-SIDE (EDGE FUNCTION)
    // ====================================================
    const params = new URLSearchParams(window.location.search);
    const projectId = params.get("projectId") || "";
    const participantId = params.get("participantId") || "";

    if (!projectId || !participantId) {
        throw new Error("projectId & participantId tidak ada di URL");
    }

    console.log("[TPDK] Hitung skor via Edge Function...");

    const res = await fetch("https://nixmychfhsnsvymkuxtm.supabase.co/functions/v1/calculate-tpdk-score", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            projectId: projectId,
            participantId: participantId,
            answers: answers
        })
    });

    if (!res.ok) {
        const errorText = await res.text().catch(() => "");
        console.error("[TPDK] Edge Function error:", res.status, errorText);
        throw new Error("Gagal hitung skor: HTTP " + res.status);
    }

    const result = await res.json();
    console.log("[TPDK] Skor dari server:", result);

    if (!result.success) {
        throw new Error(result.error || "Gagal hitung skor");
    }

    result.subtestDetails = buildSubtestDetails(result.perSubtest || { A: 0, B: 0, C: 0, D: 0 });
    result.maxPerSubtest = { A: 10, B: 5, C: 5, D: 10 };
    result.perType = {};
    result.disclaimer = "Skor ini adalah ESTIMASI kecerdasan umum berdasarkan tes penalaran dunia kerja, BUKAN diagnosis IQ klinis. Untuk diagnosis resmi, konsultasikan dengan psikolog berlisensi.";

    return result;
}

function buildSubtestDetails(perSubtest) {
    const maxPerSubtest = { A: 10, B: 5, C: 5, D: 10 };
    const subtests = {
        A: { code: "A", name: "Penalaran Verbal" },
        B: { code: "B", name: "Penalaran Kuantitatif" },
        C: { code: "C", name: "Penalaran Spasial" },
        D: { code: "D", name: "Logika Praktis" }
    };

    const result = {};
    Object.keys(subtests).forEach(function(code) {
        const info = subtests[code];
        const score = perSubtest[code] || 0;
        const max = maxPerSubtest[code] || 1;
        const pct = (score / max) * 100;

        let category = "Perlu Perhatian";
        if (pct >= 85) category = "Sangat Kuat";
        else if (pct >= 70) category = "Kuat";
        else if (pct >= 55) category = "Cukup";
        else if (pct >= 40) category = "Perlu Penguatan";

        result[info.name] = {
            code: info.code,
            name: info.name,
            score: score,
            max: max,
            percentage: pct,
            category: category
        };
    });

    return result;
}

async function finalize(auto) {
  if(sending) return;
  const missing = answers.findIndex(a => a === null);
  if(missing >= 0 && !auto){ go(missing); return; }
  sending = true;
  clearInterval(timerId);

  let scores;
    try {
        scores = await calculateScores();
    } catch (err) {
        console.error("[TPDK] Gagal hitung skor:", err);
        alert("Gagal hitung skor: " + (err.message || err) + "\n\nCoba lagi atau hubungi admin.");
        sending = false;
        return;
    }
  const submittedAt = new Date().toISOString();
  const result = {
    version: 1,
    resultType: 'TPDK',
    projectId,
    participantId,
    assessmentId: assessmentIdFromUrl, 
    assessmentIndex,
    assessmentCode,
    assessmentName: 'Tes Penalaran Dunia Kerja',
    scores,
    // Output tambahan
    generalScore: {
        value: scores.gScore,
        category: scores.gCategory,
        percentile: scores.gPercentile,
        description: scores.gDescription
    },
    subtestScores: scores.subtestDetails,
    disclaimer: scores.disclaimer,
    answers: answers.map((a, i) => ({ 
        index: i, 
        subtest: QUESTIONS[i].subtest, 
        type: QUESTIONS[i].type, 
        selected: a,
    })),
    submittedAt
};

    /* ==========================================================
     FIX: Simpan dengan UUID + index (dual-write)
     ========================================================== */
  if (assessmentIdFromUrl) {
    localStorage.setItem(`tpdk_result_v1_${projectId}_${participantId}_${assessmentIdFromUrl}`, JSON.stringify(result));
    localStorage.setItem(`assessment_result_v3_${projectId}_${participantId}_${assessmentIdFromUrl}`, JSON.stringify(result));
    console.log("[TPDK] Ã¢Å“â€œ Data disimpan dengan UUID:", assessmentIdFromUrl);
  }

  // Simpan dengan index (kompatibilitas)
  localStorage.setItem(resultKey, JSON.stringify(result));
  localStorage.setItem(`assessment_result_v3_${projectId}_${participantId}_${assessmentIndex}`, JSON.stringify(result));
  let all = [];
  try { all = JSON.parse(localStorage.getItem('talent_scope_results') || '[]'); } catch(e){}
  if(!Array.isArray(all)) all = [];
  all = all.filter(x => !(String(x?.projectId||'') === projectId && String(x?.participantId||'') === participantId && String(x?.assessmentIndex??'') === String(assessmentIndex) && String(x?.assessmentCode||'').toUpperCase() === 'TPDK'));
  all.push(result);
  localStorage.setItem('talent_scope_results', JSON.stringify(all));
  localStorage.removeItem(answerKey);

  try {
    const sb = window.supabaseClient || window.supabase;
    if(sb && typeof sb.from === 'function'){
      const participantName = el('participant')?.textContent || '';
      sb.from('tpdk_results').upsert({
        project_id: projectId,
        participant_id: participantId,
        assessment_index: assessmentIndex,
        assessment_code: assessmentCode,
        assessment_name: 'Tes Penalaran Dunia Kerja',
        participant_name: participantName,
        result_type: 'TPDK',
        scores: scores,
        raw_data: result.answers,
        submitted_at: submittedAt
      }, {
        onConflict: 'project_id,participant_id,assessment_index,assessment_code'
      }).then(({ error }) => {
        if(error) console.error('[TPDK] Supabase sync error:', error);
        else console.log('[TPDK] Ã¢Å“â€œ Tersinkron ke Supabase (tpdk_results)');
      });
    }
  } catch(err){ console.warn('[TPDK] Gagal sync Supabase:', err); }

  updateParticipantAssessmentStatus('Completed', 'Tes TPDK telah selesai', 'Menyelesaikan tes TPDK', 'test-complete');
  el('modal').classList.remove('show');
  el('quiz').style.display = 'none';
  el('finish').style.display = 'block';
}

function packageCodeOf(item){ if(!item||typeof item!=='object')return''; return String(item.code||item.assessmentCode||item.assessment_code||item.id||item.assessmentId||item.testId||'').trim(); }
function packageNameOf(item){ if(typeof item==='string')return item.trim(); if(!item||typeof item!=='object')return''; return String(item.name||item.title||item.assessmentName||item.assessment_name||item.testName||item.label||item.code||'').trim(); }
function resolveAssessmentRoute(code,name){
  const c=String(code||'').toLowerCase(),n=String(name||'').toLowerCase();
  if(c.includes('disc')||n.includes('disc'))return'disc_test.html';
  if(c.includes('papi')||n.includes('papi')||n.includes('kostick'))return'papi_kostick_test.html';
  if(c.includes('vap')||n.includes('vap')||n.includes('visual')||n.includes('performance')||n.includes('sustained attention')||n.includes('speed'))return'speedtest.html';
  if(c.includes('lsjt')||n.includes('lsjt')||n.includes('leadership'))return'sjt_leadership.html';
  if(c.includes('msjt')||n.includes('msjt')||n.includes('managerial'))return'msjt_managerial.html';
  if(c.includes('tpdk')||n.includes('tpdk')||n.includes('penalaran'))return'tpdk_test.html';
  return'';
}
function nextTest(){
  const next = assessmentIndex + 1;
  let packs = [];
  try{
    const ps = JSON.parse(localStorage.getItem('talentscope_projects')||'[]');
    const proj = ps.find(x => String(x.id||x.projectId||x.project_id||'') === projectId);
    const part = proj?.participants?.find(x => String(x.id||x.participantId||x.employeeId||x.employee_id||'') === participantId);
    packs = (Array.isArray(part?.assessments) && part.assessments.length > 0) ? part.assessments : (proj?.assessmentPackage||proj?.assessments||proj?.packages||[]);
  }catch(e){ packs = []; }
  markInternalNavigation();
  if(next >= packs.length){ location.href = 'participant-dashboard.html?completed=true'; return; }
  const nextPkg = packs[next];
  const nextCode = packageCodeOf(nextPkg);
  const nextName = packageNameOf(nextPkg) || 'Assessment';
  const nextRoute = resolveAssessmentRoute(nextCode, nextName);
  if(nextRoute){
    location.href = `${nextRoute}?projectId=${encodeURIComponent(projectId)}&participantId=${encodeURIComponent(participantId)}&assessmentIndex=${next}&assessmentCode=${encodeURIComponent(nextCode)}&assessmentName=${encodeURIComponent(nextName)}`;
  } else {
    location.href = `assessment.html?projectId=${encodeURIComponent(projectId)}&participantId=${encodeURIComponent(participantId)}&assessmentIndex=${next}&assessmentCode=${encodeURIComponent(nextCode)}&assessmentName=${encodeURIComponent(nextName)}`;
  }
}

el('confirm').addEventListener('change', e => el('start').disabled = !e.target.checked);
el('start').addEventListener('click', startQuiz);
el('prev').addEventListener('click', () => go(current - 1));
el('next').addEventListener('click', () => go(current + 1));
el('submit').addEventListener('click', requestSubmit);
el('cancelSubmit').addEventListener('click', () => el('modal').classList.remove('show'));
el('confirmSubmit').addEventListener('click', () => finalize(false));
el('nextTest').addEventListener('click', nextTest);
el('back').addEventListener('click', e => { e.preventDefault(); markInternalNavigation(); location.href = 'participant-dashboard.html'; });

loadMeta();

const HEARTBEAT_INTERVAL = 5000;
const NAVIGATION_FLAG = `talentscope_internal_navigation_${projectId}_${participantId}`;

function findProjectIndex(projects){ return projects.findIndex(project => { const ids=[project?.id,project?.projectId,project?.projectID,project?.project_id].filter(v=>v!==undefined&&v!==null&&v!==""); return ids.some(id=>String(id)===String(projectId)); }); }
function findParticipantIndex(participants){ return participants.findIndex(person => { const ids=[person?.id,person?.participantId,person?.participantID,person?.employeeId,person?.employee_id].filter(v=>v!==undefined&&v!==null&&v!==""); return ids.some(id=>String(id)===String(participantId)); }); }

function updateStore(storeKey, status, activity, historyText, historyType, forceHistory){
  try{
    const projects = JSON.parse(localStorage.getItem(storeKey)||'[]');
    if(!Array.isArray(projects)||!projects.length) return false;
    const pi = findProjectIndex(projects); if(pi<0) return false;
    const project = projects[pi]; if(!Array.isArray(project.participants)) return false;
    const pai = findParticipantIndex(project.participants); if(pai<0) return false;
    const participant = project.participants[pai];
    const now = new Date().toISOString();
    participant.isLoggedIn = true; participant.onlineStatus = 'online'; participant.lastSeen = now; participant.lastSeenAt = now; participant.lastHeartbeat = now;
    if(!participant.loginTime) participant.loginTime = now;
    if(!participant.loggedInAt) participant.loggedInAt = participant.loginTime;
    if(!participant.loginAt) participant.loginAt = participant.loginTime;
    if(!participant.lastLoginAt) participant.lastLoginAt = participant.loginTime;
    if(status){ participant.assessmentStatus=status; participant.statusAsesmen=status; participant.assessment_status=status; participant.status=status; }
    if(activity){ participant.currentActivity=activity; participant.currentTest='Tes Penalaran Dunia Kerja'; participant.activity=activity; participant.lastActivity=activity; participant.activityUpdatedAt=now; }
    participant.disconnectDetectedAt = null;
    if(forceHistory && historyText){
      if(!Array.isArray(participant.activityHistory)) participant.activityHistory = [];
      const dup = participant.activityHistory.some(item => String(item?.type||'')===String(historyType||'') && String(item?.activity||item?.description||'')===String(historyText));
      if(!dup) participant.activityHistory.unshift({ activity:historyText, description:historyText, type:historyType||'assessment', timestamp:now });
    }
    project.participants[pai] = participant; projects[pi] = project;
    localStorage.setItem(storeKey, JSON.stringify(projects));
    return true;
  } catch(error){ console.warn('Gagal sync ke '+storeKey+':', error); return false; }
}
function updateParticipantAssessmentStatus(status, activity, historyText, historyType){
  const primary = updateStore('talentscope_projects', status, activity, historyText, historyType, true);
  updateStore('projects', status, activity, historyText, historyType, false);
  return primary;
}
function updateParticipantHeartbeat(){
  updateStore('talentscope_projects', null, null, null, null, false);
  updateStore('projects', null, null, null, null, false);
}
function markInternalNavigation(){ try{ sessionStorage.setItem(NAVIGATION_FLAG, '1'); }catch(e){} }
function consumeInternalNavigation(){ try{ const v = sessionStorage.getItem(NAVIGATION_FLAG)==='1'; sessionStorage.removeItem(NAVIGATION_FLAG); return v; }catch(e){ return false; } }

function setParticipantOffline(storeKey, reason, historyText){
  try{
    const projects = JSON.parse(localStorage.getItem(storeKey)||'[]');
    if(!Array.isArray(projects)) return false;
    const pi = findProjectIndex(projects); if(pi<0) return false;
    const project = projects[pi]; if(!Array.isArray(project.participants)) return false;
    const pai = findParticipantIndex(project.participants); if(pai<0) return false;
    const participant = project.participants[pai];
    const now = new Date().toISOString();
    participant.isLoggedIn=false; participant.onlineStatus='offline'; participant.lastSeen=now; participant.lastSeenAt=now;
    participant.logoutTime=now; participant.loggedOutAt=now; participant.logoutAt=now; participant.lastLogoutAt=now;
    participant.currentActivity='Offline'; participant.activity='Offline'; participant.lastActivity='Offline';
    participant.disconnectReason = reason||'logout';
    if(historyText){
      if(!Array.isArray(participant.activityHistory)) participant.activityHistory = [];
      const recentDup = participant.activityHistory.some(item => String(item?.type||'')==='logout' && String(item?.activity||item?.description||'')===String(historyText) && Math.abs(new Date(item?.timestamp||0).getTime()-new Date(now).getTime())<10000);
      if(!recentDup) participant.activityHistory.unshift({ activity:historyText, description:historyText, type:'logout', timestamp:now });
    }
    project.participants[pai]=participant; projects[pi]=project;
    localStorage.setItem(storeKey, JSON.stringify(projects));
    return true;
  }catch(error){ console.warn('Gagal catat logout di '+storeKey+':', error); return false; }
}
function recordParticipantLogout(reason, historyText){
  setParticipantOffline('talentscope_projects', reason, historyText||'Peserta logout / menutup sesi');
  setParticipantOffline('projects', reason, null);
}
function handleExplicitLogout(){ recordParticipantLogout('manual-logout','Peserta logout dari sistem'); }
consumeInternalNavigation();
document.addEventListener('click', function(event){
  const button = event.target.closest('[data-action="logout"], #logout, #logoutBtn, .logout-btn, .btn-logout');
  if(button) handleExplicitLogout();
});
window.addEventListener('pagehide', function(event){
  if(event.persisted) return;
  let internalNavigation = false;
  try{ internalNavigation = sessionStorage.getItem(NAVIGATION_FLAG)==='1'; }catch(e){}
  if(!internalNavigation) recordParticipantLogout('tab-window-closed','Peserta keluar / menutup tab atau window');
});

updateParticipantAssessmentStatus('Ongoing','Sedang berada pada halaman tes (TPDK)','Membuka halaman tes TPDK','test-open');
updateParticipantHeartbeat();
setInterval(updateParticipantHeartbeat, HEARTBEAT_INTERVAL);
</script>
