function normalizeAssessmentCode(code, fallback) {
  var c = String(code || "").trim().toLowerCase();
  if (/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(c)) return fallback;
  return c || fallback;
}
