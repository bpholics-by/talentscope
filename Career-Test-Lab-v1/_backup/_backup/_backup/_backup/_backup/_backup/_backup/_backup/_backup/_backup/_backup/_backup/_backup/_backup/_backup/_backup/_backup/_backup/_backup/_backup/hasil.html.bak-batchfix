        </div>


    </aside>


    <div class="sidebar-overlay" id="sidebarOverlay"></div>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <div class="main">


        <!-- =================================================
             HEADER
        ================================================== -->

        <header class="header">


            <div class="header-left">


                <div class="breadcrumb">

                    <span>
                        Participant Portal
                    </span>

                    <i class="fa-solid fa-chevron-right"></i>

                    <span class="active">
                        Test Result
                    </span>

                </div>


                <h1 class="header-title">
                    Assessment Results
                </h1>


                <p class="header-description">
                    View assessment results for project participants
                </p>


            </div>


            <!-- USER -->

            <div class="header-user">


                <button
                    type="button"
                    class="hamburger-btn"
                    id="hamburgerBtn"
                    aria-label="Toggle menu"
                >

                    <span></span>
                    <span></span>
                    <span></span>

                </button>


                <div class="header-user-icon">

                    <i class="fa-solid fa-user"></i>

                </div>


                <div class="header-user-info">

                    <strong id="userRole">
