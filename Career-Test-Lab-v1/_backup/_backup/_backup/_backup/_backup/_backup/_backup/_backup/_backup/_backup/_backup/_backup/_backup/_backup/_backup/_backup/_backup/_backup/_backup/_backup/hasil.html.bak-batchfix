                            </option>

                            <option value="10" selected>
                                10
                            </option>

                            <option value="20">
                                20
                            </option>

                            <option value="30">
                                30
                            </option>

                            <option value="50">
                                50
                            </option>

                        </select>

                    </div>


                </div>



                <!-- TABLE -->

                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Project
                                </th>

                                <th>
                                    Assessment Date
                                </th>

                                <th>
                                    Participant
                                </th>

                                <th>
                                    Test Results
                                </th>

                            </tr>

                        </thead>


                        <tbody id="resultTable">

                            <!--
                                DATA PESERTA AKAN DIMUAT
                                OTOMATIS DARI LOCALSTORAGE
                                MELALUI js/result.js
                            -->

                        </tbody>

                    </table>

                </div>



                <!-- TABLE FOOTER -->

                <div class="table-footer">

                    <span id="resultCount">
                        Showing 0–0 of 0 results
                    </span>

                    <strong>
                        TalentScope Assessment Results
                    </strong>

                </div>


            </section>

           
                        </main>


    </div>


</div>



<script>

/* ==========================================================
   USER ROLE
========================================================== */

(function(){

    const userRole =
        document.getElementById("userRole");

    const userLabel =
        document.getElementById("userLabel");


    let storedUser = null;


    try{

        storedUser =
            JSON.parse(
                localStorage.getItem("currentUser")
                ||
                localStorage.getItem("user")
                ||
                localStorage.getItem("loggedInUser")
                ||
                "null"
            );

    }catch(error){

        storedUser = null;

    }


    if(!storedUser) return;


    let role =
        storedUser.role
        ||
        storedUser.userRole
        ||
        storedUser.type
        ||
        storedUser.accountType
        ||
        "";


    role =
        String(role)
        .toLowerCase();


    if(role.includes("admin")){

        userRole.textContent =
            "Administrator";

        userLabel.textContent =
            "Admin";

    }

    else if(role.includes("client")){

        userRole.textContent =
            "Client";

        userLabel.textContent =
            "Client";

    }

    else if(
        role.includes("asesor") ||
        role.includes("assessor")
    ){

        userRole.textContent =
            "Asesor";

        userLabel.textContent =
            "Asesor";

    }

})();



/* ==========================================================
   LOGOUT
========================================================== */

// Logout handler — konsisten dengan view-monitoring.html
(function() {
    var btn = document.getElementById("logoutBtn");
    if (!btn) return;
    btn.addEventListener("click", function () {
        if (!confirm("Apakah Anda yakin ingin logout?")) return;
        try {
            sessionStorage.removeItem("ts_admin_session");
            localStorage.removeItem("talentscope_current_user");
            localStorage.removeItem("currentUser");
            localStorage.removeItem("user");
            localStorage.removeItem("loggedInUser");
        } catch (e) {}
        window.location.href = "login.html";
    });
})();

</script>


<!-- Script untuk auto-redirect dengan ?id= projectId -->
<script>
(function() {
    "use strict";
    
    // ==========================================================
    // PATCH: Isi company dari username kalau kosong
    // ==========================================================
    function fixClientSessionCompany() {
        try {
            var sessionKey = "ts_admin_session";
            var raw = sessionStorage.getItem(sessionKey);
            if (!raw) {
                // Coba localStorage juga
                raw = localStorage.getItem("talentscope_current_user");
                sessionKey = "talentscope_current_user";
            }
            if (!raw) return;
            
            var session = JSON.parse(raw);
            var company = String(session.company || "").trim();
            
            // Kalau company kosong, extract dari username
            if (!company && session.username) {
                var username = String(session.username).trim();
                // Pattern: "astra-20260911.clientuser" atau "astra.clientuser"
                // Prefix = sebelum "-" atau "."
                var match = username.match(/^([a-z0-9]+)/i);
                if (match) {
                    company = match[1].toLowerCase();
                    session.company = company;
                    
                    // Simpan balik
                    if (sessionKey === "ts_admin_session") {
                        sessionStorage.setItem(sessionKey, JSON.stringify(session));
                    } else {
                        localStorage.setItem(sessionKey, JSON.stringify(session));
                    }
                    
                    console.log("[hasil.html] Company di-extract dari username:", company);
                }
            }
        } catch (e) {
            console.warn("[hasil.html] Fix company error:", e);
        }
    }
    
    // Jalankan sebelum render
    fixClientSessionCompany();
})();
</script>

<!-- Script hamburger menu -->
<script>
(function() {
    "use strict";
    function initHamburgerMenu() {
        var hamburgerBtn = document.getElementById("hamburgerBtn");
        var sidebar = document.querySelector(".sidebar");
        var overlay = document.getElementById("sidebarOverlay");
        if (!hamburgerBtn || !sidebar || !overlay) return;

        function openSidebar() {
            sidebar.classList.add("active");
            overlay.classList.add("active");
            hamburgerBtn.classList.add("active");
        }
        function closeSidebar() {
            sidebar.classList.remove("active");
            overlay.classList.remove("active");
            hamburgerBtn.classList.remove("active");
        }
        hamburgerBtn.addEventListener("click", function() {
            if (sidebar.classList.contains("active")) closeSidebar();
            else openSidebar();
        });
        overlay.addEventListener("click", closeSidebar);
        sidebar.querySelectorAll("a, button").forEach(function(el) {
            if (el.id === "hamburgerBtn") return;
            el.addEventListener("click", function() {
                if (window.innerWidth <= 768) closeSidebar();
            });
        });
        window.addEventListener("resize", function() {
            if (window.innerWidth > 768) closeSidebar();
        });
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHamburgerMenu);
    } else {
        initHamburgerMenu();
    }
})();
</script>
<!-- ==========================================================
   PATCH: PRELOAD DARI SUPABASE — SESSION ISOLATION
   ----------------------------------------------------------
   Sebelum result.js baca localStorage, kita preload data
   project + participants dari Supabase. Ini yang bikin
   halaman ini aman di device manapun.
========================================================== -->
<script>
(function () {
    "use strict";

    // Ambil projectId dari URL (?id=xxx) atau session
    function getProjectIdFromUrl() {
        try {
            var params = new URLSearchParams(window.location.search);
            var id = params.get("id");
            if (id) return String(id).trim();
        } catch (e) {}
        return "";
    }

    function getProjectIdFromSession() {
        try {
            var raw = sessionStorage.getItem("ts_admin_session") ||
                      localStorage.getItem("talentscope_current_user");
            if (!raw) return "";
            var session = JSON.parse(raw);
            return String(
                session.projectId ||
                session.project_id ||
                ""
            ).trim();
        } catch (e) { return ""; }
    }

    async function preloadFromSupabase() {
        try {
            var projectId = getProjectIdFromUrl() || getProjectIdFromSession();
            if (!projectId || projectId === "ALL") {
                console.log("[HASIL-PRELOAD] Tidak ada projectId spesifik, skip preload");
                return;
            }

            var sb = window.supabaseClient || window.supabase;
            if (!sb || typeof sb.from !== "function") {
                console.warn("[HASIL-PRELOAD] Supabase client tidak tersedia");
                return;
            }

            console.log("[HASIL-PRELOAD] Query Supabase untuk project:", projectId);

            // 1. Query project
            var projRes = await sb.from("projects").select("*").eq("id", projectId).single();
            if (projRes.error || !projRes.data) {
                console.warn("[HASIL-PRELOAD] Project tidak ada di Supabase");
                return;
            }
            var project = projRes.data;

            // 2. Query participants
            var relationsRes = await sb
                .from("project_participants")
                .select("*")
                .eq("project_id", projectId);

            var participants = [];
            if (Array.isArray(relationsRes.data) && relationsRes.data.length > 0) {
                var pids = relationsRes.data.map(function (r) { return r.participant_id; }).filter(Boolean);
                var partsRes = await sb.from("participants").select("*").in("id", pids);

                if (Array.isArray(partsRes.data)) {
                    participants = partsRes.data.map(function (p) {
                        var rawData = p.raw_data || {};
                        var merged = Object.assign({}, rawData, p);
                        var rel = relationsRes.data.find(function (r) {
                            return String(r.participant_id) === String(p.id);
                        });
                        if (rel) {
                            merged.status = p.status || rel.status || rel.participant_status || "Not Started";
                        }
                        return merged;
                    });
                }
            }

            // 3. Merge ke localStorage
            var projects = [];
            try {
                projects = JSON.parse(localStorage.getItem("talentscope_projects") || "[]");
            } catch (e) { projects = []; }
            if (!Array.isArray(projects)) projects = [];

            var existingIdx = projects.findIndex(function (p) {
                return String(p.id) === String(projectId);
            });

            var freshProject = Object.assign({}, project, {
                participants: participants
            });

            if (existingIdx >= 0) {
                projects[existingIdx] = Object.assign({}, projects[existingIdx], freshProject);
            } else {
                projects.push(freshProject);
            }

            localStorage.setItem("talentscope_projects", JSON.stringify(projects));
            console.log("[HASIL-PRELOAD] ✅ Berhasil:", participants.length, "peserta");

        } catch (error) {
            console.warn("[HASIL-PRELOAD] Gagal:", error);
        }
    }

    // Jalankan preload SEBELUM result.js
    // Cara: kita "tahan" event load — result.js menunggu preload selesai
    var __preloadPromise = preloadFromSupabase();

    // Expose ke window supaya result.js bisa tunggu
    window.__tsHasilPreload = __preloadPromise;

})();
</script>

<script src="js/result.js" defer></script>
<script src="js/access-control.js" defer></script>
<script src="js/access-control-ui.js" defer></script>

</body>
</html>
</body>

</html>